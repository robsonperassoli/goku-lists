{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src",
    "tests",
    "drizzle.config.ts",
    "ngrok.ts",
    "vitest.config.ts"
  ]
}
