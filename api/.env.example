# Copy to .env.local and fill in. Mise loads that file when you work in api/.
# Production: set the same keys as Railway service variables, not this file.

# Public API URL (ngrok HTTPS URL in local dev). Used for CORS, auth, and app links.
FRONTEND_URL=https://your-domain.ngrok-free.app

# Optional. Defaults to FRONTEND_URL.
# BETTER_AUTH_URL=

# Listen port. Defaults to 3000 if unset.
PORT=3000

# Reserved ngrok hostname without https://. Empty string is allowed.
NGROK_DOMAIN=your-domain.ngrok-free.app

# SQLite database path.
DB_FILE_NAME=./data/db/goku.sqlite

# Static files and uploaded APKs.
PUBLIC_DIR=./data/public

# Session signing secret (32+ characters).
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Bearer token for POST /release (32+ characters).
# openssl rand -base64 32
APK_UPLOAD_SECRET=

# Google OAuth client.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# true for Expo dev deep links. Anything other than "true" is false.
DEV_MODE=true

# Optional. SHA-256 of the keystore that signed the installed APK (Android App Links).
# ANDROID_SHA256_CERT_FINGERPRINT=
